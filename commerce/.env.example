# A secret key from app.keycat.net → Integrate. Server-only; never prefix it NEXT_PUBLIC_.
KEYCAT_API_KEY=

# Returned once by `npm run setup:webhook -- https://your-shop.example/api/keycat/webhook`.
KEYCAT_WEBHOOK_SECRET=

# Optional. The public HTTPS origin of this shop, used for the after-payment
# redirect. On Vercel it is derived from the production domain when unset.
NEXT_PUBLIC_SITE_URL=

# Optional. Point at a local Keycat API Worker during development.
KEYCAT_API_BASE_URL=
